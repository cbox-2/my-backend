<h1>Renew your Cbox</h1>


<script type="text/javascript">
function onnext() {
  un = document.forms["upgrade"]["uname"];
  if (un.value == "") {
    alert("Please enter your Cbox account name.");
    un.focus();
    return false;
  }
  return true;
}

// Change the user-selected state of recurring
var selrecur = true;	// true by default
function recurchk(x) {
  if (x) selrecur = true;
  else selrecur = false;
}

function paybychk(x) {

}

function cstate() {
  f = document.forms["upgrade"];

  if (f["product"] && (f["product"].value == 1 || (f["product"][0] && f["product"][0].checked))) {
  	if (!f["period"][0].checked && !f["period"][1].checked && !f["period"][2].checked) {
  		// On first load, neither of these will be checked because they are grouped with product=1
  		f["period"][0].checked = true;
  	}
  	document.getElementById("p1_terms").style.display = "block";
  	document.getElementById("p2_terms").style.display = "none";
	document.getElementById("p3_terms").style.display = "none";
  }
  else {
	  
  	if (!f["period"][3].checked && !f["period"][4].checked && !f["period"][5].checked && !f["period"][6].checked) {
  		f["period"][3].checked = true;
  	}
  	document.getElementById("p1_terms").style.display = "none";
  	document.getElementById("p2_terms").style.display = "block";
	document.getElementById("p3_terms").style.display = "none";
	
	if (f["product"] && f["product"].value == 3) {
		document.getElementById("p1_terms").style.display = "none";
		document.getElementById("p2_terms").style.display = "none";
		document.getElementById("p3_terms").style.display = "block";
		//document.getElementById("period3_1_1").checked = true;
	}
	
  }
  
  
	var $boxAutorenew = document.getElementById("boxAutorenew");
  
  // Determine whether recurring billing is available from period + method. IE8fix checkbox no value.
  if (f["payby"].value != "pp" || (f["period"].value > 6 && f["product"].value != 3)) {
    f["recur"].checked = false;
    f["recur"].disabled = true;
	$boxAutorenew.style.display = "none";
  }
  else if (f["payby"].value == "pp") {
    f["recur"].disabled = false;
    f["recur"].checked = selrecur;
	$boxAutorenew.style.display = "";
  }

}
</script>

