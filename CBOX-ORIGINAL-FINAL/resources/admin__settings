<script type="text/javascript">
function chk_settings() {
  x = "settings";
  err = "";
  f = document.forms[x];

  resetmsgs(x);

  if (err) {
    setmsg(x, "Error. Check inputs.", 2);
    setmsgdesc(x, err, 2);
    return false;
  }
  return subsaving(x, "sub", '');
}

function chksound () {
	var f = document.forms["settings"];
	
	if (f["sound"][f["sound"].selectedIndex].value == "-1") {
		document.getElementById("sound_custom").style.display = "";
	}
	else {
		document.getElementById("sound_custom").style.display = "none";
	}
}

</script>

