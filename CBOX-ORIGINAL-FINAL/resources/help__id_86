var dropCrumb = function () {
	if (!localStorage) {
		return;
	}
	var bc = getCrumbs();
	bc.push(location.href);
	bc.splice(0, bc.length - 5);
	localStorage.setItem("site:bread", JSON.stringify(bc));
};

var getCrumbs = function () {
	if (!localStorage) {
		return [];
	}
	var bcStr = localStorage.getItem("site:bread");
	var bc = [];
	if (bcStr) {
		bc = JSON.parse(bcStr);
	}
	
	return bc;
}

dropCrumb();
