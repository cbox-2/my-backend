<h1>Get your own Cbox</h1>

<p>
Open a new Cbox in one step. Afterwards you will have the option of purchasing a paid plan to 
activate all your Cbox features. Or you can install your Cbox right away and start chatting! 
</p>


<script type="text/javascript">
// Form validation
function chk_fsignup() {
  err = "";
  fn = "fsignup";
  f = document.forms[fn];
  foc = "";
  
  // Clear all errors.
  resetmsgs("fsignup");

  if (f["uname"].value == "") {
    err += "<li>Please choose a unique name for your Cbox.</li>";
    if (!foc) foc = "uname";
  }
  else {
    try {
      if (!f["uname"].value.match(/^[a-z][a-z0-9_-]{3,19}$/i)) {
        err += "<li>Invalid Cbox name. Please use A-Z and 0-9, with no spaces, 4-20 characters.</li>";
        if (!foc) foc = "uname";
      }
    } catch (e) {}
  }

  if (f["email"] && f["email"].value == "") {
    err += "<li>Please enter your email address.</li>";
    if (!foc) foc = "email";
  }
  else {
    try {
      if (!f["email"].value.match(/^.+@.+\.[a-zA-Z]{2,9}$/)) {
        err += "<li>Invalid email address.</li>";
        if (!foc) foc = "email";
      }
    } catch (e) {}
  }
  
  if (f["pword"] && f["pword"].value == "") {
    err += "<li>Please enter a password.</li>";
    if (!foc) foc = "pword";
  }
  else if (f["pword2"] && f["pword2"].value == "") {
    err += "<li>Please enter your password twice to confirm it.</li>";
    if (!foc) foc = "pword2";
  }
  else if (f["pword"] && f["pword2"] && f["pword"].value != f["pword2"].value) {
    err += "<li>Your passwords don't match; please retype them.</li>";
    if (!foc) foc = "pword";
  }
  
  if (f["terms"] && f["terms"].checked == false) {
    err += "<li>You need to agree to the terms and conditions of service.</li>";
  }

  // Must come last.
  if (!err && f["email"] && (f["email"].value.indexOf("hottmail.com") != -1
    || f["email"].value.indexOf("htomail.com") != -1 
    || f["email"].value.indexOf("www.") == 0
    || f["email"].value.indexOf("http://") == 0
    || f["email"].value.indexOf("https://") == 0
    || f["email"].value.indexOf(".con") != -1
    || f["email"].value.indexOf("..com") != -1
    || f["email"].value.indexOf("@.") != -1
    || f["email"].value.indexOf(".co") == f["email"].value.length - 3))
  {
    if(!confirm("We detected a possible typo in your email address, "+(f["email"].value)+"\nIf you see a mistake, please click Cancel and correct it.")) {
      f["email"].focus();
      return false;
    }
  }
  
  document.forms["fsignup"]["vdchk"].value = "1";

  if (err) {
    setmsg("fsignup", "There was a problem with your input.", 2);
    setmsgdesc("fsignup", err, 2);
    if (foc) f[foc].focus();
    return false;
  }
  return subsaving(fn, "sub", 'Registering...');;
}

</script>

