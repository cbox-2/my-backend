<script language="JavaScript">
var hit = new Array();
var openans = new Array();

function toggleanswer(id) {
  if (typeof(document.getElementById("ans"+id).style.display) == "undefined") {
    return true;
  }
  x = document.getElementById("ans"+id);
  if (x.style.display != "none") {
    x.style.display = "none";
  }
  else {
    x.style.display = "";
    if (document.images && !hit[id]) {
      (new Image()).src="/help?hit="+id;
      hit[id] = true;
    }
	if (x.scrollIntoViewIfNeeded) {
		// Cuts question title off in some cases; workaround not straightforward. 
		x.scrollIntoViewIfNeeded();
	}
  }
  return false;
}
</script>

